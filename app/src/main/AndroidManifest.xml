<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The in-app updater. Android still shows its own confirmation for every
         install; this only allows CineVerse to be the one that asks. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New-episode and release reminders. Asked for at the moment the viewer
         switches one on, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opening a trailer in the YouTube app, where it is installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube" />

        <!--
            The streaming apps "Where to watch" can open directly.

            Android 11 hides every other package unless it is declared here, and
            the failure is SILENT: `getPackageInfo` throws NameNotFound exactly
            as it would for an app that is not installed, so Netflix on the phone
            looks identical to no Netflix at all and every button quietly falls
            back to the website.
        -->
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.jio.media.ondemand" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.cbs.app" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.sonyliv" />
        <package android:name="com.mubi" />
        <package android:name="com.aha.android" />
        <package android:name="com.suntv.sunnxt" />
        <package android:name="com.google.android.videos" />
    </queries>

    <application
        android:name=".CineVerseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CineVerse.Splash"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CineVerse.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A CineVerse link from anywhere opens in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cineverse.pages.dev" />
            </intent-filter>

            <!-- The launcher shortcuts and the widget's rows. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="cineverse" />
            </intent-filter>

            <!-- Share a title to CineVerse from any app to look it up. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Where the package installer reports back during an update. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- Continue Watching on the home screen. -->
        <receiver
            android:name=".widget.ContinueWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_continue">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_widget_info" />
        </receiver>

        <!-- The streak and today, at a glance. -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

    </application>
</manifest>
