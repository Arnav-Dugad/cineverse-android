<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice search. Asked for the first time the microphone is tapped, never before. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 16 Live Updates: the film you are watching, in the status bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The in-app updater. Android still shows its own confirmation for every
         install; this only allows CineVerse to be the one that asks. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- New-episode and release reminders. Asked for at the moment the viewer
         switches one on, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opening a trailer in the YouTube app, where it is installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <!-- The phone's speech recogniser, which voice search talks to. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>

        <!--
            The streaming apps "Where to watch" can open directly.

            Android 11 hides every other package unless it is declared here, and
            the failure is SILENT: `getPackageInfo` throws NameNotFound exactly
            as it would for an app that is not installed, so Netflix on the phone
            looks identical to no Netflix at all and every button quietly falls
            back to the website.
        -->
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.jio.media.ondemand" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.cbs.app" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.graymatrix.did" />
        <package android:name="com.sonyliv" />
        <package android:name="com.mubi" />
        <package android:name="com.aha.android" />
        <package android:name="com.suntv.sunnxt" />
        <package android:name="com.google.android.videos" />
    </queries>

    <application
        android:name=".CineVerseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CineVerse.Splash"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CineVerse.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A CineVerse link from anywhere opens in the app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="cineverse.pages.dev" />
            </intent-filter>

            <!-- The launcher shortcuts and the widget's rows. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="cineverse" />
            </intent-filter>

            <!-- Share a title to CineVerse from any app to look it up. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Where the package installer reports back during an update. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- "Mark watched" on a new-episode notification. -->
        <receiver
            android:name=".notify.MarkWatchedReceiver"
            android:exported="false" />

        <!-- Continue Watching on the home screen. -->
        <receiver
            android:name=".widget.ContinueWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_continue">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/continue_widget_info" />
        </receiver>

        <!-- The streak and today, at a glance. -->
        <!-- One show's next episode, counting down; pinned from its page. -->
        <receiver
            android:name=".widget.NextEpisodeWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_next">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_episode_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.ShowCountdownReceiver"
            android:exported="false"
            android:label="@string/widget_countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/show_countdown_info" />
        </receiver>
        <receiver
            android:name=".widget.PinnedReceiver"
            android:exported="false" />

        <!-- Up Next: live countdowns. -->
        <receiver
            android:name=".widget.UpNextWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_upnext">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upnext_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!--
            AppFunctions: Gemini and other assistants on Android 16+ can act in
            CineVerse ("mark the next Severance episode watched"). The class is
            generated from agent/CineVerseFunctions.kt; only the system, holding
            BIND_APP_FUNCTION_SERVICE, can bind it.
        -->
        <receiver
            android:name=".notify.WatchingNowReceiver"
            android:exported="false" />

        <service
            android:name=".agent.CineVerseFunctionService"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            android:exported="true"
            tools:targetApi="36">
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />
            <property
                android:name="android.app.appfunctions.v2"
                android:value="cineverse_functions.xml" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
