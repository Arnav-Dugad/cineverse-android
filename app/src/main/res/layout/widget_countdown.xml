<?xml version="1.0" encoding="utf-8"?>
<!-- A live countdown for the Up Next widget. A native Chronometer ticks in the
     launcher's own process, so the seconds move without the app waking up. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:countDown="true"
    android:fontFeatureSettings="tnum"
    android:textColor="#FFFBBF24"
    android:textSize="15sp"
    android:textStyle="bold" />
